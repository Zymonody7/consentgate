# Copy to .env and fill in ONE provider key. The agent uses CONSENTGATE_PROVIDER
# to decide which variable to read.
#
# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=

# Optional overrides
CONSENTGATE_PROVIDER=openai
CONSENTGATE_MODEL=gpt-4o-mini
# Minimum model confidence before the deterministic gate escalates to a human.
CONSENTGATE_MIN_CONFIDENCE=0.6
# Set to 1 to run the whole pipeline without any LLM call (canned decisions),
# so the Interoperability workflow can be demoed with no API key and no cost.
CONSENTGATE_REPLAY=0
