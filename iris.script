    zn "%SYS"

    // Dev convenience only. Comment out for production use.
    do ##class(Security.Users).UnExpireUserPasswords("*")

    // The write API for recording a human review. The read-only console page is
    // served statically by the web server, so no CSP application is needed for it.
    Set app = ##class(Security.Applications).%New()
    Set app.Name = "/consentgate/api"
    Set app.NameSpace = "CONSENTGATE"
    Set app.DispatchClass = "ConsentGate.Rest.Console"
    Set app.AutheEnabled = 36
    Set app.Enabled = 1
    Do app.%Save()

    zn "CONSENTGATE"

    // Load without compiling, then compile the package, then the toolset and
    // the agent last: tool specifications resolve at compile time.
    do $System.OBJ.LoadDir("/home/irisowner/dev/src", "k", .err, 1)
    zwrite err
    do $System.OBJ.CompilePackage("ConsentGate", "ck")
    do $System.OBJ.Compile("ConsentGate.Agent.ConsentTools", "ck")
    do $System.OBJ.Compile("ConsentGate.Agent.ConsentAgent", "ck")

    // Seed synthetic patients, consent documents and requestors.
    do ##class(ConsentGate.Setup).Seed()

    // Start the production so the file service is watching ./data/in.
    do ##class(ConsentGate.Setup).StartProduction()

    // Seed the read-only console snapshot.
    Do ##class(ConsentGate.Export.Snapshot).Write()

    // Bring it back up when the container restarts.
    Set ^Ens.AutoStart = "ConsentGate.Production"

    halt
